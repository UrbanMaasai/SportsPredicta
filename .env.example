# Server-side only. Enables the live search scraper, vision OCR and AI text parsing.
GEMINI_API_KEY=

# Optional. Without these the app runs in local-only mode (LocalStorage persistence, no sign-in).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

PORT=3000

# Max requests per client per minute to /api/fixtures/* (each may call Gemini). Default 20.
API_RATE_LIMIT_PER_MIN=20
# Set when running behind a reverse proxy so rate limiting sees the real client IP ("true" or a hop count).
TRUST_PROXY=
